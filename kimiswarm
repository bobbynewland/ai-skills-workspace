#!/bin/bash
# Kimi Swarm - Load balancer across multiple API keys

KEYS_DIR="/root/.openclaw/workspace/.keys"
ENDPOINT="https://integrate.api.nvidia.com/v1/chat/completions"
MODEL="moonshotai/kimi-k2.5"

# Get all swarm keys
ALL_KEYS=$(cat "$KEYS_DIR"/kimi-*.key 2>/dev/null | grep "^nvapi" | sort -u)

KEY_COUNT=$(echo "$ALL_KEYS" | wc -w)
if [ "$KEY_COUNT" -eq 0 ]; then
    echo "No keys found!"
    exit 1
fi

# Round-robin select
SELECT_NUM=$(( ($$ % KEY_COUNT) + 1))
SELECTED_KEY=$(echo "$ALL_KEYS" | sed -n "${SELECT_NUM}p")

echo "Keys: $KEY_COUNT | Using key #$SELECT_NUM"

if [ -z "$1" ]; then
    echo "Usage: kimiswarm 'prompt here'"
    exit 1
fi

curl -s --max-time 120 -X POST "$ENDPOINT" \
    -H "Authorization: Bearer $SELECTED_KEY" \
    -H "Content-Type: application/json" \
    -d "{\"model\":\"$MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"$1\"}],\"max_tokens\":4096,\"temperature\":0.1}"
